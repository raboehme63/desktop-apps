{
  "schema_version": 1,
  "id": "section_intro",
  "kind": "section_intro",
  "label": { "de": "Abschnittsstart", "en": "Section intro" },
  "applies_to": "page",
  "photo_count": 1,
  "note": "Linke Seite der ersten Doppelseite je Reiseabschnitt. Nicht durch ein Foto-Raster ersetzbar.",
  "slots": [
    {
      "id": "country_shape",
      "type": "country_silhouette",
      "bind": "entry.country",
      "optional": true,
      "note": "Länderumriss. Braucht Reverse-Geocoding (OP-01) oder manuelles Land."
    },
    {
      "id": "coordinates",
      "type": "text",
      "bind": "entry.coordinates",
      "optional": true,
      "transform": "dms"
    },
    {
      "id": "country_flag",
      "type": "flag",
      "bind": "entry.country",
      "optional": true
    },
    {
      "id": "country_name",
      "type": "text",
      "bind": "entry.country_name",
      "transform": "uppercase",
      "optional": true
    },
    {
      "id": "title",
      "type": "text",
      "bind": "entry.title",
      "transform": "uppercase"
    },
    {
      "id": "youtube",
      "type": "youtube_links",
      "bind": "entry.youtube_urls",
      "optional": true,
      "qr": true,
      "note": "URL als Text und als QR-Code, mehrere Links untereinander."
    },
    {
      "id": "cover",
      "type": "media",
      "accept": ["photo", "video", "track"],
      "bind": "entry.cover_image",
      "fit": "cover",
      "droppable": true,
      "note": "Standard: Eintrags-Titelbild. Per Drag-and-drop aus der Abschnittsleiste überschreibbar, ohne die Timeline zu ändern."
    },
    {
      "id": "date",
      "type": "text",
      "bind": "entry.started_at",
      "transform": "long_date"
    },
    {
      "id": "day_index",
      "type": "badge",
      "bind": "entry.day_number",
      "optional": true,
      "note": "DAY n in Timeline-Reihenfolge der veröffentlichten Abschnitte."
    },
    {
      "id": "weather",
      "type": "text",
      "bind": "entry.weather",
      "optional": true,
      "note": "Kein Wetterfeld im Journal. Slot bleibt leer, bis eine Quelle existiert."
    },
    {
      "id": "altitude",
      "type": "text",
      "bind": "entry.altitude_m",
      "optional": true,
      "transform": "meters",
      "note": "Höhe am Cover-GPS oder Trackpunkt, sonst leer."
    }
  ]
}
