{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traveljournal.local/schemas/export-document-v2.json",
  "title": "Travelbook-Dokument (Editiermodus)",
  "description": "Komposition im Projektordner (travelbook.json). Schema 2: Fotoflächen mit Rahmen, Crop und z. Schema 1 (media[]) wird beim Laden migriert. Der Binder legt fehlende Kapitel aus published_entries an.",
  "type": "object",
  "required": ["schema_version", "product", "chapters"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "product": { "type": "string", "const": "travelbook" },
    "page_size": { "type": "string" },
    "photo_layout": {
      "type": "string",
      "description": "Veraltet. Gewählte Vorlage für das aktuelle Seitenformat; wird nach photo_layouts migriert."
    },
    "photo_layouts": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Gewählte Fotoseiten-Vorlage je Seitenformat (a4-portrait, a4-landscape, square)."
    },
    "spread_overlap": {
      "type": "boolean",
      "description": "Fotos dürfen über die innere Kante der Doppelseite ragen."
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "spreads"],
        "properties": {
          "section_id": { "type": "integer" },
          "spreads": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/spread" }
          }
        }
      }
    }
  },
  "$defs": {
    "spread": {
      "type": "object",
      "required": ["id", "verso", "recto"],
      "properties": {
        "id": { "type": "string" },
        "initial": { "type": "boolean" },
        "verso": { "$ref": "#/$defs/page_instance" },
        "recto": { "$ref": "#/$defs/page_instance" }
      }
    },
    "page_instance": {
      "type": "object",
      "required": ["layout"],
      "properties": {
        "layout": { "type": "string" },
        "locked": { "type": "boolean" },
        "media": {
          "type": "array",
          "items": { "type": ["integer", "null"] },
          "description": "Schema 1: source_file_id je Slot. Wird nach elements migriert."
        },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/photo_element" }
        }
      }
    },
    "photo_element": {
      "type": "object",
      "required": ["id", "source_file_id", "frame"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "const": "photo" },
        "source_file_id": { "type": "integer" },
        "frame": {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "w": { "type": "number" },
            "h": { "type": "number" }
          }
        },
        "crop": {
          "type": "object",
          "properties": {
            "scale": { "type": "number", "minimum": 0.2 },
            "pan_x": { "type": "number", "minimum": -1, "maximum": 1 },
            "pan_y": { "type": "number", "minimum": -1, "maximum": 1 },
            "angle": { "type": "number", "description": "Drehung im Rahmen, Grad im Uhrzeigersinn." }
          }
        },
        "z": { "type": "integer" }
      }
    }
  }
}
